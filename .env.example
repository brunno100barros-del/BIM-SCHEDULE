# Configuração opcional do serviço BIM SCHEDULE (backend).
# Copie para backend/.env e descomente o que precisar. Sem este arquivo, os padrões abaixo são usados.

# Pasta de dados (banco, IFC enviados, logs, backups). Padrão: %LOCALAPPDATA%\BIM-SCHEDULE no Windows.
# BIM_SCHEDULE_DATA_DIR=D:\Dados\BIM-SCHEDULE

# URL explícita do banco. ATENÇÃO: quando definida, a migração automática dos dados legados é desativada.
# BIM_SCHEDULE_DATABASE_URL=sqlite:///D:/Dados/bim_schedule.db

# Porta do serviço local (sempre em 127.0.0.1).
# BIM_SCHEDULE_PORT=8000

# Token local exigido no cabeçalho X-BIM-Schedule-Token (o app Windows gera um por sessão).
# BIM_SCHEDULE_LOCAL_API_TOKEN=

# Processamento em segundo plano
# BIM_SCHEDULE_JOB_MAX_WORKERS=1
# BIM_SCHEDULE_JOB_CANCEL_GRACE_SECONDS=10
# BIM_SCHEDULE_MAX_IFC_UPLOAD_MB=1024

# Logs: DEBUG, INFO, WARNING, ERROR
# BIM_SCHEDULE_LOG_LEVEL=INFO

# IA (somente preparação nesta versão; nenhuma análise é executada)
# BIM_SCHEDULE_AI_PROVIDER=manual
# BIM_SCHEDULE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# BIM_SCHEDULE_OLLAMA_MODEL=qwen3.5:4b
