{
  "name": "bim-schedule-frontend",
  "private": true,
  "version": "0.4.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "postinstall": "node copy-wasm.js",
    "test": "npm run test:unit && npm run test:schedule",
    "test:unit": "vitest run",
    "test:schedule": "node --test tests/schedule-engine.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "web-ifc": "^0.0.50",
    "web-ifc-three": "^0.0.126"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "2.1.9"
  }
}
